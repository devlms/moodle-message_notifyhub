{{!
    @template message_notifyhub/hub

    The notification hub page.

    Example context (json):
    {
        "hubon": true, "notificationsurl": "#", "haschannels": true,
        "channels": [{"position": 1, "name": "ntfy", "label": "ntfy", "on": true, "sent": 12, "failed": 1,
            "upurl": "", "downurl": "#", "toggleurl": "#", "testurl": "#"}],
        "sms": [{"name": "Kenya", "sent": 40, "failed": 2, "pending": 0}], "smsurl": "#",
        "emailfailed": 3, "testmailurl": "#", "mailhealthurl": "",
        "deliveries": [{"time": "25/11/26, 10:00", "user": "Sam Student", "userurl": "#",
            "notification": "mod_assign / assign_notification", "channel": "ntfy", "status": "Sent", "ok": true}],
        "catalogue": [{"component": "message_ntfy", "label": "ntfy", "kind": "App notifications", "regions": "Worldwide",
            "guide": "#", "repo": "#", "installed": false, "caninstall": true, "manual": false,
            "releasesurl": "#"}],
        "actionurl": "#", "sesskey": "x"
    }
}}
<div class="message-notifyhub">
    <p>{{#str}} hubintro, message_notifyhub {{/str}}</p>
    {{^hubon}}
    <div class="alert alert-warning">{{#str}} hubisoff, message_notifyhub, {{notificationsurl}} {{/str}}</div>
    {{/hubon}}

    <h3 class="mt-4">{{#str}} channels, message_notifyhub {{/str}}</h3>
    {{#haschannels}}
    <table class="generaltable" id="message-notifyhub-channels">
        <caption class="accesshide">{{#str}} channels, message_notifyhub {{/str}}</caption>
        <thead><tr>
            <th scope="col">{{#str}} order, message_notifyhub {{/str}}</th>
            <th scope="col">{{#str}} channel, message_notifyhub {{/str}}</th>
            <th scope="col">{{#str}} inhub, message_notifyhub {{/str}}</th>
            <th scope="col">{{#str}} sent7, message_notifyhub {{/str}}</th>
            <th scope="col">{{#str}} failed7, message_notifyhub {{/str}}</th>
            <th scope="col">{{#str}} actions, message_notifyhub {{/str}}</th>
        </tr></thead>
        <tbody>
        {{#channels}}
            <tr data-channel="{{name}}">
                <td>{{position}}</td>
                <th scope="row">{{label}}</th>
                <td>{{#on}}<span class="badge bg-success text-white">{{#str}} on, message_notifyhub {{/str}}</span>{{/on}}{{^on}}<span class="badge bg-secondary">{{#str}} off, message_notifyhub {{/str}}</span>{{/on}}</td>
                <td>{{sent}}</td>
                <td>{{failed}}</td>
                <td class="text-nowrap">
                    {{#upurl}}<a href="{{upurl}}" class="me-1">{{#pix}} t/up, core, {{#str}} moveup, message_notifyhub, {{label}} {{/str}} {{/pix}}</a>{{/upurl}}{{^upurl}}<span class="icon me-1" aria-hidden="true"></span>{{/upurl}}
                    {{#downurl}}<a href="{{downurl}}" class="me-2">{{#pix}} t/down, core, {{#str}} movedown, message_notifyhub, {{label}} {{/str}} {{/pix}}</a>{{/downurl}}{{^downurl}}<span class="icon me-2" aria-hidden="true"></span>{{/downurl}}
                    <a href="{{testurl}}" class="btn btn-sm btn-outline-secondary me-2">{{#str}} sendtest, message_notifyhub, {{label}} {{/str}}</a>
                    <a href="{{toggleurl}}">{{#on}}{{#str}} turnoff, message_notifyhub, {{label}} {{/str}}{{/on}}{{^on}}{{#str}} turnon, message_notifyhub, {{label}} {{/str}}{{/on}}</a>
                </td>
            </tr>
        {{/channels}}
        </tbody>
    </table>
    {{/haschannels}}
    {{^haschannels}}<p>{{#str}} nochannels, message_notifyhub, {{notificationsurl}} {{/str}}</p>{{/haschannels}}

    <h3 class="mt-4">{{#str}} smsheading, message_notifyhub {{/str}}</h3>
    {{#sms.0}}
    <table class="generaltable" id="message-notifyhub-sms">
        <caption class="accesshide">{{#str}} smsheading, message_notifyhub {{/str}}</caption>
        <thead><tr>
            <th scope="col">{{#str}} gateway, message_notifyhub {{/str}}</th>
            <th scope="col">{{#str}} sent7, message_notifyhub {{/str}}</th>
            <th scope="col">{{#str}} failed7, message_notifyhub {{/str}}</th>
            <th scope="col">{{#str}} pending, message_notifyhub {{/str}}</th>
        </tr></thead>
        <tbody>{{#sms}}<tr><th scope="row">{{name}}</th><td>{{sent}}</td><td>{{failed}}</td><td>{{pending}}</td></tr>{{/sms}}</tbody>
    </table>
    {{/sms.0}}
    {{^sms.0}}<p>{{#str}} nosms, message_notifyhub {{/str}}</p>{{/sms.0}}
    <p><a href="{{smsurl}}">{{#str}} managesms, message_notifyhub {{/str}}</a></p>

    <h3 class="mt-4">{{#str}} emailheading, message_notifyhub {{/str}}</h3>
    <p>{{#str}} emailfailed, message_notifyhub, {{emailfailed}} {{/str}}</p>
    <p><a href="{{testmailurl}}">{{#str}} testmail, message_notifyhub {{/str}}</a></p>
    <p>{{#mailhealthurl}}<a href="{{mailhealthurl}}">{{#str}} mailhealth, message_notifyhub {{/str}}</a>{{/mailhealthurl}}{{^mailhealthurl}}{{#str}} mailhealthget, message_notifyhub {{/str}}{{/mailhealthurl}}</p>

    <h3 class="mt-4">{{#str}} recent, message_notifyhub {{/str}}</h3>
    {{#deliveries.0}}
    <table class="generaltable" id="message-notifyhub-log">
        <caption class="accesshide">{{#str}} recent, message_notifyhub {{/str}}</caption>
        <thead><tr>
            <th scope="col">{{#str}} time, message_notifyhub {{/str}}</th>
            <th scope="col">{{#str}} user, message_notifyhub {{/str}}</th>
            <th scope="col">{{#str}} notification, message_notifyhub {{/str}}</th>
            <th scope="col">{{#str}} channel, message_notifyhub {{/str}}</th>
            <th scope="col">{{#str}} status, message_notifyhub {{/str}}</th>
        </tr></thead>
        <tbody>
        {{#deliveries}}
            <tr><td>{{time}}</td><td>{{#userurl}}<a href="{{userurl}}">{{user}}</a>{{/userurl}}{{^userurl}}{{user}}{{/userurl}}</td>
                <td>{{notification}}</td><td>{{channel}}</td>
                <td>{{#ok}}<span class="badge bg-success text-white">{{status}}</span>{{/ok}}{{^ok}}<span class="badge bg-danger text-white">{{status}}</span>{{/ok}}</td></tr>
        {{/deliveries}}
        </tbody>
    </table>
    {{/deliveries.0}}
    {{^deliveries.0}}<p>{{#str}} norecent, message_notifyhub {{/str}}</p>{{/deliveries.0}}

    <h3 class="mt-4">{{#str}} install, message_notifyhub {{/str}}</h3>
    <p>{{#str}} installintro, message_notifyhub {{/str}}</p>
    <table class="generaltable" id="message-notifyhub-catalogue">
        <caption class="accesshide">{{#str}} install, message_notifyhub {{/str}}</caption>
        <thead><tr>
            <th scope="col">{{#str}} channel, message_notifyhub {{/str}}</th>
            <th scope="col">{{#str}} kind, message_notifyhub {{/str}}</th>
            <th scope="col">{{#str}} regions, message_notifyhub {{/str}}</th>
            <th scope="col">{{#str}} actions, message_notifyhub {{/str}}</th>
        </tr></thead>
        <tbody>
        {{#catalogue}}
            <tr><th scope="row"><a href="{{guide}}">{{label}}</a></th><td>{{kind}}</td><td>{{regions}}</td>
                <td>
                    {{#installed}}<span class="badge bg-success text-white">{{#str}} installed, message_notifyhub {{/str}}</span>{{/installed}}
                    {{#caninstall}}
                    <form method="post" action="{{actionurl}}" class="d-inline">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="install">
                        <input type="hidden" name="component" value="{{component}}">
                        <button type="submit" class="btn btn-secondary btn-sm">{{#str}} installbutton, message_notifyhub, {{label}} {{/str}}</button>
                    </form>
                    {{/caninstall}}
                    {{#manual}}{{#str}} manualinstall, message_notifyhub, {{releasesurl}} {{/str}}{{/manual}}
                </td></tr>
        {{/catalogue}}
        </tbody>
    </table>
</div>
